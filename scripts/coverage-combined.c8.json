{
  "all": true,
  "reporter": ["text", "json-summary"],
  "reports-dir": "coverage/combined",
  "temp-directory": "coverage/tmp-combined",
  "include": ["build-test/**/*.js", "scripts/**/*.js", "scripts/**/*.mjs"],
  "exclude": [
    "build-test/__tests__/**",
    "build-test/App.js",
    "build-test/components/**",
    "build-test/hooks/useCommandHistory.js",
    "build-test/hooks/usePrefersReducedMotion.js",
    "build-test/main.js",
