{
  "name": "nullid",
  "private": true,
  "version": "0.1.0",
  "description": "Local-first browser/PWA and Node CLI workbench for hashing, redaction, sanitization, encryption, secure notes, and package verification.",
  "license": "MIT",
  "author": "Kamran Boroomand <50832086+KamranBoroomand@users.noreply.github.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KamranBoroomand/NullID.git"
  },
  "bugs": {
    "url": "https://github.com/KamranBoroomand/NullID/issues"
  },
  "homepage": "https://nullid.kamranboroomand.ir/",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "cli": "node scripts/nullid-local.mjs",
    "build": "tsc -b && vite build && node scripts/generate-public-site.mjs && node scripts/generate-precache-manifest.mjs && node scripts/verify-precache-manifest.mjs && node scripts/write-build-info.mjs && node scripts/generate-sbom.mjs dist/sbom.json && node scripts/generate-build-manifest.mjs && node scripts/verify-web-output.mjs && node scripts/verify-entry-budget.mjs",
    "verify:build": "node scripts/verify-build-manifest.mjs && node scripts/verify-precache-manifest.mjs && node scripts/verify-web-output.mjs",
    "verify:web": "node scripts/verify-web-output.mjs",
    "verify:precache": "node scripts/verify-precache-manifest.mjs",
    "budget:entry": "node scripts/verify-entry-budget.mjs",
    "build:repro": "npm run build && npm run verify:build",
    "sbom": "node scripts/generate-sbom.mjs",
    "setup:precommit": "node scripts/install-precommit.mjs",
    "release:bundle": "node scripts/package-release.mjs",
    "release:verify": "node scripts/verify-release-bundle.mjs",
    "release:dry-run": "node scripts/release-dry-run.mjs",
    "desktop:init": "node scripts/tauri-init.mjs",
    "desktop:smoke": "node scripts/desktop-smoke.mjs",
    "assets:brand": "node scripts/generate-brand-assets.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "i18n:check": "STRICT_I18N_PHRASES=1 node scripts/check-i18n-coverage.mjs",
    "check:i18n": "npm run i18n:check",
    "docs:links": "node scripts/check-doc-links.mjs",
    "lint": "eslint src tests scripts public --ext .ts,.tsx,.js,.mjs",
    "lint:network": "node scripts/lint.js",
    "deadcode": "knip",
    "dead-code": "npm run deadcode",
    "duplication": "jscpd src scripts --min-lines 12 --min-tokens 80 --threshold 1.5",
    "duplicate-code": "npm run duplication",
    "coverage:core": "c8 --config scripts/coverage-app.c8.json npm test",
    "coverage:app": "npm run coverage:core",
    "coverage:scripts": "c8 --config scripts/coverage-scripts.c8.json npm test",
    "coverage:combined": "c8 --config scripts/coverage-combined.c8.json npm test",
    "coverage:evidence": "node scripts/coverage-evidence.mjs --write coverage/evidence-summary.json",
    "coverage:verify": "node scripts/coverage-evidence.mjs --verify coverage/evidence-summary.json",
    "coverage:assert-canonical": "node scripts/coverage-evidence.mjs --verify coverage/evidence-summary.json --assert-canonical",
    "coverage:canonical": "npm run coverage && npm run coverage:assert-canonical",
    "coverage": "npm run coverage:core && npm run coverage:scripts && npm run coverage:combined && npm run coverage:evidence && npm run coverage:verify",
    "audit:headers": "node scripts/verify-security-headers.mjs",
    "audit:deps": "node scripts/audit-dependencies.mjs",
    "security:check": "npm run audit:deps && npm run audit:headers && npm run lint && npm run lint:network && npm run test",
    "pretest": "node scripts/clean-test-build.mjs",
    "test": "tsc -p tsconfig.test.json && node --test build-test/__tests__/*.js",
    "e2e": "npm run test:e2e:app",
    "test:e2e": "npm run test:e2e:app",
    "test:e2e:app": "node scripts/run-e2e.mjs tests/e2e/app.spec.ts tests/e2e/i18n-layout.spec.ts tests/e2e/i18n-switching.spec.ts",
    "test:e2e:offline": "node scripts/run-production-e2e.mjs --suite offline --base /",
    "test:e2e:upgrade": "node scripts/run-production-e2e.mjs --suite upgrade --base /",
    "test:e2e:production": "node scripts/run-production-e2e.mjs --suite all --base / --base /nullid-e2e/",
    "e2e:install": "playwright install --with-deps chromium",
    "test:visual": "node scripts/run-e2e.mjs tests/e2e/visual-regression.spec.ts",
    "test:visual:update": "node scripts/run-e2e.mjs tests/e2e/visual-regression.spec.ts --update-snapshots",
    "visual:drift-report": "node scripts/collect-visual-drift.mjs",
    "test:e2e:i18n-layout": "node scripts/run-e2e.mjs tests/e2e/i18n-layout.spec.ts",
    "validate": "npm run typecheck && npm run i18n:check && npm run docs:links && npm run lint && npm run lint:network && npm run deadcode && npm run duplication && npm run coverage && npm run audit:deps && npm run audit:headers && npm run test && npm run test:e2e:app && npm run test:e2e:production && npm run build && npm run verify:build && npm run release:bundle && npm run release:verify"
  },
  "dependencies": {
    "@noble/hashes": "^1.8.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@cyclonedx/cyclonedx-npm": "^6.0.1",
    "@emnapi/core": "^1.11.3",
    "@emnapi/runtime": "^1.11.3",
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.3.0",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "ajv-formats-draft2019": "^1.6.1",
    "c8": "^12.0.0",
    "eslint": "^9.39.4",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "jscpd": "^5.0.16",
    "knip": "^6.32.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2"
  }
}
